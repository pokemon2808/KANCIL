<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= student ? 'Edit' : 'Tambah' %> Siswa - Presensi QR</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="layout-fixed">
  <div class="wrapper">
    <%- include('partials/sidebar', { active: 'students' }) %>
    <div class="content-wrapper">
      <header class="content-header">
        <button class="btn btn-light sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <h1 class="mb-1"><%= student ? 'Edit Siswa' : 'Tambah Siswa Baru' %></h1>
            <p class="text-muted mb-0">Isi data siswa untuk sistem presensi QR.</p>
          </div>
        </div>
      </header>
      <section class="content">
        <div class="card shadow-sm p-4">
          <form action="<%= action %>" method="post">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Nama</label>
                <input type="text" name="name" class="form-control" required value="<%= student ? student.name : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">Kelas</label>
                <select name="class_id" class="form-select" required>
                  <% classes.forEach(function(kelas) { %>
                    <option value="<%= kelas.id %>" <%= student && student.class_id === kelas.id ? 'selected' : '' %>><%= kelas.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Nomor HP</label>
                <input type="text" name="phone" class="form-control" value="<%= student ? student.phone : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">Nomor HP Orang Tua</label>
                <input type="text" name="parent_phone" class="form-control" value="<%= student ? student.parent_phone : '' %>">
              </div>
              <div class="col-md-4">
                <label class="form-label">Poin</label>
                <input type="number" name="points" class="form-control" value="<%= student ? student.points : 0 %>">
              </div>
              <div class="col-md-4">
                <label class="form-label">Aktif</label>
                <select name="active" class="form-select">
                  <option value="1" <%= !student || student.active === 1 ? 'selected' : '' %>>Ya</option>
                  <option value="0" <%= student && student.active === 0 ? 'selected' : '' %>>Tidak</option>
                </select>
              </div>
            </div>
            <div class="mt-4">
              <button class="btn btn-primary"><%= student ? 'Simpan Perubahan' : 'Simpan Siswa' %></button>
              <a href="/students" class="btn btn-secondary ms-2">Batal</a>
            </div>
          </form>
        </div>
      </section>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/sidebar.js"></script>
</body>
</html>
