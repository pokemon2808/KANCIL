<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grafik & Monitoring - Presensi QR</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="layout-fixed">
  <div class="wrapper">
    <%- include('partials/sidebar', { active: 'monitoring' }) %>
    <div class="content-wrapper">
      <header class="content-header">
        <button class="btn btn-light sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <h1 class="mb-1">Grafik & Monitoring</h1>
            <p class="text-muted mb-0">Pantau grafik keterlambatan, ringkasan status, dan unduh laporan Excel/PDF dari halaman ini.</p>
          </div>
          <div class="topbar-actions">
            <a href="/export/excel" class="btn btn-success btn-sm">Export Excel</a>
            <a href="/export/pdf" class="btn btn-danger btn-sm">Export PDF</a>
          </div>
        </div>
      </header>

      <section class="content">
        <div class="row g-3 mb-0">
          <% classes.forEach(function(kelas) { %>
            <div class="col-12 col-md-6 col-xl-4">
              <div class="card shadow-sm h-100">
                <div class="card-body">
                  <h5 class="card-title mb-2"><%= kelas.name %></h5>
                  <p class="mb-1">Jumlah siswa: <strong><%= kelas.total_students %></strong></p>
                  <p class="mb-0">Terlambat: <strong class="text-danger"><%= kelas.late_students %></strong></p>
                  <a href="/classes/<%= kelas.id %>/qr" class="btn btn-primary btn-sm mt-3">Lihat QR Kelas</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="row g-3">
          <div class="col-12 col-lg-6">
            <div class="card shadow-sm p-3">
              <h5 class="mb-3">Grafik Keterlambatan</h5>
              <canvas id="lateChart" height="220"></canvas>
            </div>
          </div>
          <div class="col-12 col-lg-6">
            <div class="card shadow-sm p-3">
              <h5 class="mb-3">Ringkasan</h5>
              <div id="summaryCards" class="row g-3"></div>
              <div class="mt-4">
                <h6>Lokasi Sekolah</h6>
                <div class="mapbox">
                  <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=118.9805%2C-3.5441%2C118.9827%2C-3.5424&layer=mapnik&marker=-3.543247742936886%2C118.98159579854247" class="w-100" style="min-height:250px;border:0"></iframe>
                  <p class="small text-muted mt-2 mb-0">Lokasi sekolah: -3.543247742936886, 118.98159579854247</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card shadow-sm p-3">
          <h5 class="mb-3">Scan Terakhir</h5>
          <div class="table-responsive">
            <table class="table table-striped table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Nama</th>
                  <th>Kelas</th>
                  <th>Status</th>
                  <th>Waktu</th>
                </tr>
              </thead>
              <tbody>
                <% recent.forEach(function(item, idx) { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= item.name %></td>
                    <td><%= item.class_name %></td>
                    <td><%= item.status %></td>
                    <td><%= item.last_status_time %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/sidebar.js"></script>
</body>
</html>
