<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Code <%= kelas.name %> - Presensi QR</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="layout-fixed">
  <div class="wrapper">
    <%- include('partials/sidebar', { active: 'classes' }) %>
    <div class="content-wrapper">
      <header class="content-header">
        <button class="btn btn-light sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <h1 class="mb-1">QR Code Kelas <%= kelas.name %></h1>
            <p class="text-muted mb-0">Scan menggunakan HP siswa untuk presensi otomatis.</p>
          </div>
          <a href="/classes" class="btn btn-secondary">Kembali ke Kelas</a>
        </div>
      </header>
      <section class="content">
        <div class="card shadow-sm p-4 text-center">
          <img src="<%= qrData %>" alt="QR Code <%= kelas.name %>" class="img-fluid mx-auto" style="max-width:320px;">
          <p class="mt-3">URL scan: <a href="<%= qrUrl %>"><%= qrUrl %></a></p>
          <a href="/classes/<%= kelas.id %>/qr/download" class="btn btn-primary mt-3">Unduh QR Kelas</a>
        </div>
      </section>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/sidebar.js"></script>
</body>
</html>
