<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Siswa - Presensi QR</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="layout-fixed">
  <div class="wrapper">
    <%- include('partials/sidebar', { active: 'students' }) %>
    <div class="content-wrapper">
      <header class="content-header">
        <button class="btn btn-light sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <h1 class="mb-1">Data Siswa</h1>
            <p class="text-muted mb-0">Kelola siswa, nomor urut, kelas, poin, dan status aktif.</p>
          </div>
          <a href="/students/new" class="btn btn-primary">Tambah Siswa</a>
        </div>
      </header>
      <section class="content">
        <div class="card shadow-sm rounded bg-white mb-3 p-3">
          <form class="row g-3 align-items-end" method="get" action="/students">
            <div class="col-12 col-md-5">
              <label class="form-label">Cari Nama</label>
              <input type="text" name="name" class="form-control" placeholder="Masukkan nama siswa" value="<%= searchName || '' %>">
            </div>
            <div class="col-12 col-md-4">
              <label class="form-label">Filter Kelas</label>
              <select name="class_id" class="form-select">
                <option value="all" <%= searchClassId === 'all' ? 'selected' : '' %>>Semua Kelas</option>
                <% classes.forEach(function(kelas) { %>
                  <option value="<%= kelas.id %>" <%= searchClassId == kelas.id ? 'selected' : '' %>><%= kelas.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-12 col-md-3 d-grid">
              <button type="submit" class="btn btn-primary">Cari</button>
            </div>
          </form>
          <% const exportParams = [];
             if (searchClassId) exportParams.push(`class_id=${searchClassId}`);
             if (searchName) exportParams.push(`name=${encodeURIComponent(searchName)}`);
             const exportQuery = exportParams.length ? `?${exportParams.join('&')}` : '';
          %>
          <div class="d-flex flex-column flex-md-row gap-2 mt-3">
            <a href="/export/excel<%= exportQuery %>" class="btn btn-success btn-sm">Export Excel</a>
            <a href="/export/pdf<%= exportQuery %>" class="btn btn-danger btn-sm">Export PDF</a>
          </div>
        </div>
        <div class="table-responsive shadow-sm rounded bg-white">
          <table class="table table-hover table-striped mb-0">
            <thead class="table-light">
              <tr>
                <th>No Urut</th>
                <th>Nama</th>
                <th>Kelas</th>
                <th>HP</th>
                <th>HP Orang Tua</th>
                <th>Poin</th>
                <th>Status</th>
                <th>Waktu</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(function(student) { %>
                <tr>
                  <td><%= student.nomor_urut %></td>
                  <td><%= student.name %></td>
                  <td><%= student.class_name %></td>
                  <td><%= student.phone %></td>
                  <td><%= student.parent_phone %></td>
                  <td><%= student.points %></td>
                  <td><%= student.status || '-' %></td>
                  <td><%= student.last_scan ? student.last_scan.slice(0,19).replace('T',' ') : '-' %></td>
                  <td>
                    <a href="/students/edit/<%= student.nomor_urut %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form action="/students/delete/<%= student.nomor_urut %>" method="post" class="d-inline" onsubmit="return confirm('Hapus siswa ini?');">
                      <button class="btn btn-sm btn-danger">Hapus</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/sidebar.js"></script>
</body>
</html>
