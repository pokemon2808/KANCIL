<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Status Notifikasi - Presensi QR</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="layout-fixed">
  <div class="wrapper">
    <%- include('partials/sidebar', { active: 'notifications' }) %>
    <div class="content-wrapper">
      <header class="content-header">
        <button class="btn btn-light sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <h1 class="mb-1">Status Notifikasi</h1>
            <p class="text-muted mb-0">Lihat riwayat pengiriman WhatsApp, provider yang digunakan, dan tautan wa.me untuk notifikasi fallback.</p>
          </div>
          <div class="d-flex gap-2">
            <a href="/export/excel" class="btn btn-success btn-sm">Export Excel</a>
            <a href="/export/pdf" class="btn btn-danger btn-sm">Export PDF</a>
          </div>
        </div>
      </header>

      <section class="content">
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-4 border-primary">
              <div class="card-body">
                <h6 class="text-uppercase text-muted mb-2">Tanggal</h6>
                <h3 class="mb-0"><%= today %></h3>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-4 border-success">
              <div class="card-body">
                <h6 class="text-uppercase text-muted mb-2">Total Notifikasi</h6>
                <h3 class="mb-0"><%= notifications.length %></h3>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-4 border-warning">
              <div class="card-body">
                <h6 class="text-uppercase text-muted mb-2">Provider Ringkasan</h6>
                <% summary.forEach(function(item) { %>
                  <div><strong><%= item.provider || 'unknown' %></strong> : <%= item.count %></div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>

        <div class="card shadow-sm p-3">
          <h5 class="mb-3">Riwayat Notifikasi Terakhir</h5>
          <div class="table-responsive">
            <table class="table table-striped table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Waktu</th>
                  <th>Nama</th>
                  <th>Kelas</th>
                  <th>Provider</th>
                  <th>Link WA</th>
                  <th>Error</th>
                </tr>
              </thead>
              <tbody>
                <% notifications.forEach(function(item, idx) { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= item.sent_at ? item.sent_at.replace('T',' ').slice(0,19) : '-' %></td>
                    <td><%= item.student_name || '-' %></td>
                    <td><%= item.class_name || '-' %></td>
                    <td><%= item.provider || 'unknown' %></td>
                    <td>
                      <% if (item.provider_link) { %>
                        <a href="<%= item.provider_link %>" target="_blank" rel="noreferrer" class="btn btn-outline-primary btn-sm">Buka WA</a>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td><%= item.error_message || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/sidebar.js"></script>
</body>
</html>
