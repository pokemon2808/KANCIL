<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kelas & QR - Presensi QR</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="layout-fixed">
  <div class="wrapper">
    <%- include('partials/sidebar', { active: 'classes' }) %>
    <div class="content-wrapper">
      <header class="content-header">
        <button class="btn btn-light sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <h1 class="mb-1">Manajemen Kelas</h1>
            <p class="text-muted mb-0">Tambahkan kelas baru dan akses QR Code untuk setiap kelas.</p>
          </div>
          <form action="/classes/create" method="post" class="d-flex gap-2 flex-column flex-md-row w-100 w-md-auto">
            <input type="text" name="name" placeholder="Nama Kelas baru" class="form-control" required>
            <button class="btn btn-primary">Tambah Kelas</button>
          </form>
        </div>
      </header>
      <section class="content">
        <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <div class="row g-3">
          <% classes.forEach(function(kelas) { %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                  <div>
                    <h5 class="card-title mb-3"><%= kelas.name %></h5>
                    <div class="d-flex gap-2 mb-3">
                      <a href="/classes/<%= kelas.id %>/qr" class="btn btn-outline-primary btn-sm">Lihat QR</a>
                      <a href="/classes/<%= kelas.id %>/qr/download" class="btn btn-primary btn-sm">Unduh QR</a>
                    </div>
                  </div>
                  <form action="/classes/delete/<%= kelas.id %>" method="post" onsubmit="return confirm('Hapus kelas ini beserta data terkait?');" class="mt-3">
                    <button type="submit" class="btn btn-danger btn-sm w-100">Hapus Kelas</button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/sidebar.js"></script>
</body>
</html>
